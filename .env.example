# FalkorDB connection. For local Docker, these defaults are enough.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=shortagebridge

# Optional: enables the server-side Gemini evidence brief. Leave blank to use
# the built-in deterministic fallback. Never use NEXT_PUBLIC_ for this key.
GEMINI_API_KEY=

# For a hosted FalkorDB instance (such as FalkorDB Cloud, when deploying to
# Vercel), set FALKORDB_URL instead of FALKORDB_HOST/FALKORDB_PORT. Credentials
# may be supplied separately rather than embedded in the URL. Use the falkors://
# scheme with FALKORDB_TLS=true if your instance requires TLS.
# FALKORDB_URL=falkor://host:port
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_TLS=false
